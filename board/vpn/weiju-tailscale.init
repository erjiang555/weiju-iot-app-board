#!/bin/sh
APP=/opt/weiju-tailscale/vpn_runner.py
PIDFILE=/var/run/weiju-tailscale/runner.pid
running() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE")
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\000' ' ' < "/proc/$pid/cmdline" | grep -Fq "$APP"
}
case "$1" in
start)
    if running; then echo 'VPN already running'; exit 0; fi
    /usr/bin/python3 "$APP" </dev/null >/dev/null 2>&1 &
    ;;
stop)
    if running; then
        kill "$pid"
        count=0
        while running && [ "$count" -lt 15 ]; do sleep 1; count=$((count+1)); done
        if running; then echo 'VPN still stopping'; exit 1; fi
    fi
    ;;
restart) "$0" stop && "$0" start;;
status) if running; then echo "VPN running (PID $pid)"; else echo 'VPN stopped'; exit 1; fi;;
*) echo "Usage: $0 {start|stop|restart|status}"; exit 1;;
esac
