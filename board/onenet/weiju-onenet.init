#!/bin/sh
APP=/opt/weiju-onenet/onenet_agent.py
PIDFILE=/var/run/weiju-onenet.pid
running() {
    [ -f "$PIDFILE" ] || return 1
    pid=$(cat "$PIDFILE")
    case "$pid" in ''|*[!0-9]*) return 1;; esac
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\000' ' ' < "/proc/$pid/cmdline" | grep -Fq "$APP"
}
case "$1" in
    start)
        if running; then echo "weiju-onenet already running (PID $pid)"; exit 0; fi
        /usr/bin/python3 "$APP" </dev/null >/dev/null 2>&1 &
        echo "weiju-onenet starting"
        ;;
    stop)
        if running; then
            kill "$pid"
            count=0
            while running && [ "$count" -lt 25 ]; do sleep 1; count=$((count + 1)); done
            if running; then echo "weiju-onenet is still stopping"; exit 1; fi
        fi
        echo "weiju-onenet stopped"
        ;;
    restart)
        "$0" stop && "$0" start
        ;;
    status)
        if running; then echo "weiju-onenet running (PID $pid)"; else echo "weiju-onenet stopped"; exit 1; fi
        ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1;;
esac
